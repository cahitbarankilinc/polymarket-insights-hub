{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "server:dev": "node server/index.mjs",
    "app:dev": "concurrently -k \"npm:server:dev\" \"npm:dev\" \"wait-on tcp:8080 tcp:8787 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:8080 electron .\"",
    "app:build": "npm run build",
    "app:dist:win": "npm run build && electron-builder --win",
    "app:dist:mac": "npm run build && electron-builder --mac",
    "app:dist": "npm run build && electron-builder"
  },
  "dependencies": {
